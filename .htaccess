RewriteEngine On
RewriteBase /

# 0. Desativar MultiViews para evitar conflitos com o mod_rewrite
Options -MultiViews

# 1. Redirecionar index.html para a raiz /
RewriteCond %{THE_REQUEST} \s/+(.+/)?index\.html[\s?] [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# 2. Redirecionar acessos diretos a arquivos .html para a URL limpa sem .html (para SEO)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Reescrever internamente URLs sem extensão para o arquivo .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [L]